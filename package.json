{
  "name": "meocord",
  "description": "Decorator-based Discord bot framework built on discord.js. Brings NestJS-style controllers, dependency injection, guards, and testing utilities to bot development — with a full CLI and TypeScript-first design.",
  "version": "4.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "format": "prettier --write \"**/*.md\" \"src/bin/app-template/**/*.template\"",
    "format:check": "prettier --check \"**/*.md\" \"src/bin/app-template/**/*.template\"",
    "lint": "bun run format && eslint --fix . && tsc --noEmit && tsc --noEmit --project tsconfig.test.json && tsc --noEmit --project tsconfig.eslint.json",
    "build": "rm -rf ./dist && rollup -c",
    "prepare": "husky",
    "test": "vitest run",
    "verify:generated": "bun scripts/verify-generated.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc --noEmit --project tsconfig.test.json",
    "changeset": "changeset",
    "release:version": "changeset version && prettier --write CHANGELOG.md",
    "release:publish": "changeset publish",
    "notices": "bun scripts/third-party-notices.ts",
    "notices:check": "bun scripts/third-party-notices.ts --check"
  },
  "bin": "./dist/esm/bin/meocord.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meocord/meocord.git"
  },
  "homepage": "https://meocord.dev",
  "bugs": {
    "url": "https://github.com/meocord/meocord/issues"
  },
  "license": "MIT",
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/types/core/index.d.ts",
        "default": "./dist/esm/core/index.js"
      },
      "require": {
        "types": "./dist/types/core/index.d.cts",
        "default": "./dist/cjs/core/index.cjs"
      }
    },
    "./decorator": {
      "import": {
        "types": "./dist/types/decorator/index.d.ts",
        "default": "./dist/esm/decorator/index.js"
      },
      "require": {
        "types": "./dist/types/decorator/index.d.cts",
        "default": "./dist/cjs/decorator/index.cjs"
      }
    },
    "./common": {
      "import": {
        "types": "./dist/types/common/index.d.ts",
        "default": "./dist/esm/common/index.js"
      },
      "require": {
        "types": "./dist/types/common/index.d.cts",
        "default": "./dist/cjs/common/index.cjs"
      }
    },
    "./interface": {
      "import": {
        "types": "./dist/types/interface/index.d.ts",
        "default": "./dist/esm/interface/index.js"
      },
      "require": {
        "types": "./dist/types/interface/index.d.cts",
        "default": "./dist/cjs/interface/index.cjs"
      }
    },
    "./enum": {
      "import": {
        "types": "./dist/types/enum/index.d.ts",
        "default": "./dist/esm/enum/index.js"
      },
      "require": {
        "types": "./dist/types/enum/index.d.cts",
        "default": "./dist/cjs/enum/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/types/testing/index.d.ts",
        "default": "./dist/esm/testing/index.js"
      },
      "require": {
        "types": "./dist/types/testing/index.d.cts",
        "default": "./dist/cjs/testing/index.cjs"
      }
    },
    "./eslint": {
      "import": {
        "types": "./meocord.eslint.d.ts",
        "default": "./meocord.eslint.mjs"
      },
      "require": {
        "types": "./meocord.eslint.d.cts",
        "default": "./meocord.eslint.cjs"
      }
    }
  },
  "files": [
    "dist/**/*",
    "meocord.eslint.mjs",
    "meocord.eslint.cjs",
    "meocord.eslint.d.ts",
    "meocord.eslint.d.cts",
    "package.json",
    "LICENSE",
    "AUTHOR.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@rsbuild/core": "^2.2.8",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "dayjs": "^1.11.23",
    "inversify": "^8.2.3",
    "jiti": "^2.7.0",
    "lodash-es": "^4.18.1",
    "reflect-metadata": "^0.2.2",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-swc": "^0.4.1",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "rollup": "^4.63.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^18.0.3"
  },
  "publishConfig": {
    "provenance": true
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "typescript",
    "bot-framework",
    "decorator",
    "dependency-injection",
    "inversify",
    "controller",
    "guard",
    "slash-command",
    "nestjs-style",
    "cli",
    "testing",
    "meocord"
  ]
}
