# Checks against real Discord: `bun run test:e2e`. Copy this file to .env, which git ignores, and fill it
# in for a Discord application and server kept for testing only; see "Checking against real Discord" in
# CONTRIBUTING.md. Without the two required values, test:e2e skips and exits 0.

# Required. The test application's bot token (Developer Portal > your test app > Bot > Reset Token).
MEOCORD_E2E_BOT_TOKEN=
# Required. The test server's id, where the smoke commands are registered.
MEOCORD_E2E_GUILD_ID=
# Optional. A text channel in the test server where the helper bot posts and reacts.
MEOCORD_E2E_CHANNEL_ID=
# Optional. A second bot's token, in the same server, that sends the message and reaction the checks wait for.
MEOCORD_E2E_HELPER_BOT_TOKEN=
# Optional. Your Discord user id, for `--manual`: each call is checked against it, and one from anyone else is flagged.
MEOCORD_E2E_CLICKER_ID=
