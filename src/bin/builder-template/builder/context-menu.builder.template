import { ContextMenuCommandBuilder, ApplicationCommandType } from 'discord.js'
import { CommandBuilder } from 'meocord/decorator'
import { CommandType } from 'meocord/enum'

@CommandBuilder(CommandType.CONTEXT_MENU)
export class {{builderClassName}} {
  build() {
    return new ContextMenuCommandBuilder().setName('{{commandName}}').setType(ApplicationCommandType.{{contextMenuType}})
  }
}
