import { SlashCommandBuilder } from 'discord.js'
import { CommandBuilder } from 'meocord/decorator'
import { CommandType } from 'meocord/enum'

@CommandBuilder(CommandType.SLASH)
export class {{builderClassName}} {
  // The name comes from @Command, so the command registered and the one handled are always the same
  build(commandName: string) {
    return new SlashCommandBuilder().setName(commandName).setDescription('Describe what /{{commandName}} does')
  }
}
