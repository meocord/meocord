import { ChannelSelectMenuInteraction, Collection, TextChannel } from 'discord.js'
import { createMockChannel, createMockInteraction, getResponse, MeoCordTestingModule } from 'meocord/testing'
import { {{className}}ChannelSelectMenuController } from './{{kebabCaseName}}.channel-select-menu.controller.js'

describe('{{className}}ChannelSelectMenuController', () => {
  const module = MeoCordTestingModule.create({ controllers: [{{className}}ChannelSelectMenuController] }).compile()

  it('answers with the channels selected', async () => {
    const channel = createMockChannel(TextChannel, { id: '1' })
    const interaction = createMockInteraction(ChannelSelectMenuInteraction, {
      customId: '{{commandName}}',
      channels: new Collection([[channel.id, channel]]),
    })

    await module.invoke({{className}}ChannelSelectMenuController, 'handle{{className}}', interaction)

    // A component's answer edits the message it is on
    expect(getResponse(interaction).calls.map(call => call.method)).toEqual(['update'])
  })
})
