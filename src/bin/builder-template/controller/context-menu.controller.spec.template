import { {{contextMenuInteraction}} } from 'discord.js'
import { createMockInteraction, getResponse, MeoCordTestingModule } from 'meocord/testing'
import { {{className}}ContextMenuController } from './{{kebabCaseName}}.context-menu.controller.js'

describe('{{className}}ContextMenuController', () => {
  const module = MeoCordTestingModule.create({ controllers: [{{className}}ContextMenuController] }).compile()

  it('replies with its greeting', async () => {
    const interaction = createMockInteraction({{contextMenuInteraction}}, { commandName: '{{commandName}}' })

    await module.invoke({{className}}ContextMenuController, 'handle{{className}}', interaction)

    const [answer] = getResponse(interaction).calls
    expect(answer?.method).toBe('reply')
    expect(answer?.payload).toMatchObject({ content: 'Hello from {{commandName}}!' })
  })
})
