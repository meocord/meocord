import { {{className}}ModalSubmitController } from './{{kebabCaseName}}.modal-submit.controller.js'

describe('{{className}}ModalSubmitController', () => {
  const module = MeoCordTestingModule.create({ controllers: [{{className}}ModalSubmitController] }).compile()

  it('answers the submission', async () => {
    const interaction = createMockInteraction(ModalSubmitInteraction, { customId: '{{commandName}}' })

    await module.invoke({{className}}ModalSubmitController, 'handle{{className}}', interaction)

    const [answer] = getResponse(interaction).calls
