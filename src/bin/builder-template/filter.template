import { Catch } from 'meocord/decorator'
import { type ExceptionFilter } from 'meocord/interface'
import { type ExecutionContext } from 'meocord/common'

/** Thrown by handlers to be answered by {{className}}Filter. */
export class {{className}}Error extends Error {}

@Catch({{className}}Error)
export class {{className}}Filter implements ExceptionFilter<{{className}}Error> {
  // One instance serves every call: keep per-call state in local variables
  async catch(error: {{className}}Error, context: ExecutionContext): Promise<void> {
    // TODO: Decide what the user is told; response is undefined for messages, reactions, events and autocomplete
    await context.response?.error(error, { message: error.message, visibility: 'private' })
  }
}
