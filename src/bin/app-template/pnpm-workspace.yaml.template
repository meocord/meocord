# Whether pnpm runs each dependency's install script. @swc/core and unrs-resolver load the native binding pnpm installs for
# this platform; their scripts only check it loads and fetch a fallback when it doesn't, so they stay off.
allowBuilds:
  '@swc/core': false
  unrs-resolver: false

# The meocord version that created this app is the one it depends on, already run to create it, so it installs however
# recently it was published
minimumReleaseAgeExclude:
  - meocord
