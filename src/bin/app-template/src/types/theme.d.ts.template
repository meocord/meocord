import 'meocord/interface'

// The app's own theme tokens, beside MeoCord's: add a role to ThemeColors, ThemeEmojis or ThemeButtons, or a group to
// MeoCordTheme, then set it in @MeoCord({ theme }), which requires it. The import above makes this an augmentation:
// without it, the declaration would replace meocord/interface instead of extending it.
declare module 'meocord/interface' {}
